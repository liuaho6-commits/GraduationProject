# ========================
# 1. 忽略 Python 虚拟环境 (你的截图里是 env)
# ========================
env/
venv/
.venv/

# ========================
# 2. 忽略数据文件夹 (raw_data 通常很大，不要传)
# ========================
raw_data/
*.csv
*.xlsx

# ========================
# 3. 忽略前端依赖 (node_modules 文件成千上万，绝对不能传)
# ========================
node_modules/
dist/
npm-debug.log*

# ========================
# 4. 忽略 Python 编译缓存
# ========================
__pycache__/
*.py[cod]

# ========================
# 5. 忽略 IDE 配置
# ========================
.idea/
.vscode/
*.swp
.DS_Store